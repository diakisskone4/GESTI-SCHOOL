# URL de base de l'API Django (avec /api/v1). Un téléphone/émulateur ne peut pas
# joindre "localhost" (ça pointe vers lui-même) : utilisez l'adresse LAN de votre
# machine de développement (ipconfig / ifconfig), ex. http://192.168.1.42:8000/api/v1
# Pour l'émulateur Android uniquement, 10.0.2.2 fonctionne aussi.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:8000/api/v1
